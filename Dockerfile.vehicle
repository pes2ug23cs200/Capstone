FROM python:3.10-slim

WORKDIR /app

# 1. Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    python3-dev \
    libgomp1 \
    git \
    cmake \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Upgrade pip
RUN pip install --upgrade pip

# 3. Install Python packages (removed the COPY line from here)
RUN pip install \
    tensorflow-cpu \
    flwr \
    numpy \
    pandas \
    scikit-learn \
    pynacl \
    cryptography

# 4. Copy your project files
# Note: Ensure these folders exist in the same directory as this Dockerfile
COPY vehicle/ /app
COPY shared/ /app/shared
COPY model/ /app/model

# 5. Run your application
CMD ["python", "main.py"]